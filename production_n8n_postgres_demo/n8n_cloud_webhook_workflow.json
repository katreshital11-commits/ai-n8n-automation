    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body ?? $json }}",
        "options": {
          "responseCode": "={{ $json.statusCode ?? 200 }}"
        }
      },
      "id": "e61d3ad6-1d1f-4c2e-8b0a-2a2c0c13a103",
      "name": "Respond to Webhook",
